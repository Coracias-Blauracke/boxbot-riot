;   param=value ; assign values to parameters

config_version=5

[application]

config/name="boxbot-riot"
run/main_scene="uid://ypmpa6ofxxh2"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*uid://bu10n1u8fqjhm"

[display]

