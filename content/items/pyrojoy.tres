[ext_resource type="Script" path="res://core/effects/dynamic_effect.gd" id="3_base"]
[ext_resource type="Script" path="res://core/effects/library/effect_stat_per_world_count.gd" id="4_count"]

[sub_resource type="Resource" id="e_burning"]
