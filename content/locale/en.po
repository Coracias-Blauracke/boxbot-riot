msgid "STAT_AREA_SIZE"
msgstr "Area Size"

msgid "STAT_AREA_SIZE_DESC"
msgstr "How wide your explosions reach. A multiplier on every blast radius, so 1.0 is the authored size."

msgid "STAT_ARMOR"
msgstr "Armor"

msgid "STAT_ARMOR_DESC"
msgstr "Takes a share off every hit, armor / (armor + 15). The share climbs more slowly the higher it gets, but each point is worth the same amount of effective health."

msgid "STAT_ATTACK_SPEED"
msgstr "Attack Speed"

msgid "STAT_ATTACK_SPEED_DESC"
msgstr "How fast your weapons swing and fire. A multiplier, so 1.0 is the ordinary rate."

msgid "STAT_BLEED_CHANCE"
msgstr "Bleed Chance"

msgid "STAT_BLEED_CHANCE_DESC"
msgstr "Chance for one of your hits to start a bleed, added to whatever the weapon brings."

msgid "STAT_BLEED_DAMAGE"
msgstr "Bleed Damage"

msgid "STAT_BLEED_DAMAGE_DESC"
msgstr "Damage each tick of bleeding deals."

msgid "STAT_BLEED_MAX_STACKS"
msgstr "Bleed Max Stacks"

msgid "STAT_BLEED_MAX_STACKS_DESC"
msgstr "How many bleeds one enemy can carry at once."

msgid "STAT_BLEED_RATE"
msgstr "Bleed Rate"

msgid "STAT_BLEED_RATE_DESC"
msgstr "How fast bleeding ticks. A faster bleed delivers its ticks sooner, never more of them."

msgid "STAT_BOUNCING"
msgstr "Bouncing"

msgid "STAT_BOUNCING_DESC"
msgstr "How many further enemies a projectile bounces to."

msgid "STAT_BURN_CHANCE"
msgstr "Burn Chance"

msgid "STAT_BURN_CHANCE_DESC"
msgstr "Chance for one of your hits to set the target on fire."

msgid "STAT_BURN_DAMAGE"
msgstr "Burn Damage"

msgid "STAT_BURN_DAMAGE_DESC"
msgstr "Damage each tick of burning deals."

msgid "STAT_BURN_MAX_STACKS"
msgstr "Burn Max Stacks"

msgid "STAT_BURN_MAX_STACKS_DESC"
msgstr "How many fires one enemy can carry at once."

msgid "STAT_BURN_RATE"
msgstr "Burn Rate"

msgid "STAT_BURN_RATE_DESC"
msgstr "How fast burning ticks. A faster fire delivers its ticks sooner, never more of them."

msgid "STAT_BURN_SPREAD_RADIUS"
msgstr "Burn Spread Radius"

msgid "STAT_BURN_SPREAD_RADIUS_DESC"
msgstr "How far fire jumps when something burning dies."

msgid "STAT_CRIT_CHANCE"
msgstr "Crit Chance"

msgid "STAT_CRIT_CHANCE_DESC"
msgstr "Chance for a shot to land critically. Rolled once per shot, so every pellet of a blast crits together."

msgid "STAT_CRIT_MULTIPLIER"
msgstr "Crit Multiplier"

msgid "STAT_CRIT_MULTIPLIER_DESC"
msgstr "How much a critical hit multiplies damage by."

msgid "STAT_CURRENCY_GAIN"
msgstr "Currency Gain"

msgid "STAT_CURRENCY_GAIN_DESC"
msgstr "How much more you earn. It never changes what anything costs."

msgid "STAT_DODGE"
msgstr "Dodge"

msgid "STAT_DODGE_DESC"
msgstr "Chance to avoid a hit outright. Capped at 60%, and it answers hits only - never damage over time."

msgid "STAT_ELEMENTAL_DAMAGE"
msgstr "Elemental Damage"

msgid "STAT_ELEMENTAL_DAMAGE_DESC"
msgstr "Damage added to elemental weapons."

msgid "STAT_ENGINEERING"
msgstr "Engineering"

msgid "STAT_ENGINEERING_DESC"
msgstr "How well the things you build fight for you."

msgid "STAT_HARVESTING"
msgstr "Harvesting"

msgid "STAT_HARVESTING_DESC"
msgstr "How much you gather at the end of a wave."

msgid "STAT_HEAT_CAPACITY"
msgstr "Heat Capacity"

msgid "STAT_HEAT_CAPACITY_DESC"
msgstr "How long a weapon fires before it overheats."

msgid "STAT_HEAT_DISSIPATION"
msgstr "Heat Dissipation"

msgid "STAT_HEAT_DISSIPATION_DESC"
msgstr "How fast a weapon cools down."

msgid "STAT_HP_REGEN"
msgstr "HP Regen"

msgid "STAT_HP_REGEN_DESC"
msgstr "Health restored every second, during a wave and between waves alike."

msgid "STAT_LIFESTEAL"
msgstr "Lifesteal"

msgid "STAT_LIFESTEAL_DESC"
msgstr "Share of the damage you land that comes back as health. Hits only, and taken from what actually landed."

msgid "STAT_LUCK"
msgstr "Luck"

msgid "STAT_LUCK_DESC"
msgstr "Tilts the odds wherever something is rolled."

msgid "STAT_MAP_SIZE"
msgstr "Map Size"

msgid "STAT_MAP_SIZE_DESC"
msgstr "How large the arena is."

msgid "STAT_MAX_HP"
msgstr "Max HP"

msgid "STAT_MAX_HP_DESC"
msgstr "How much damage you can take. At zero you go down."

msgid "STAT_MELEE_DAMAGE"
msgstr "Melee Damage"

msgid "STAT_MELEE_DAMAGE_DESC"
msgstr "Damage added to your melee weapons."

msgid "STAT_MOVEMENT_SPEED"
msgstr "Movement Speed"

msgid "STAT_MOVEMENT_SPEED_DESC"
msgstr "How fast you walk."

msgid "STAT_PICKUP_RANGE"
msgstr "Pickup Range"

msgid "STAT_PICKUP_RANGE_DESC"
msgstr "How far away you collect things from."

msgid "STAT_PIERCING"
msgstr "Piercing"

msgid "STAT_PIERCING_DESC"
msgstr "How many further enemies a projectile passes through."

msgid "STAT_POISON_CHANCE"
msgstr "Poison Chance"

msgid "STAT_POISON_CHANCE_DESC"
msgstr "Chance for one of your hits to poison the target."

msgid "STAT_POISON_DAMAGE"
msgstr "Poison Damage"

msgid "STAT_POISON_DAMAGE_DESC"
msgstr "Damage each tick of poison deals."

msgid "STAT_POISON_MAX_STACKS"
msgstr "Poison Max Stacks"

msgid "STAT_POISON_MAX_STACKS_DESC"
msgstr "How many poisons one enemy can carry at once."

msgid "STAT_POISON_RATE"
msgstr "Poison Rate"

msgid "STAT_POISON_RATE_DESC"
msgstr "How fast poison ticks. A faster poison delivers its ticks sooner, never more of them."

msgid "STAT_PROJECTILE_SPEED"
msgstr "Projectile Speed"

msgid "STAT_PROJECTILE_SPEED_DESC"
msgstr "How fast your projectiles travel. A multiplier."

msgid "STAT_RANGE"
msgstr "Range"

msgid "STAT_RANGED_DAMAGE"
msgstr "Ranged Damage"

msgid "STAT_RANGED_DAMAGE_DESC"
msgstr "Damage added to your ranged weapons."

msgid "STAT_RANGE_DESC"
msgstr "How far your weapons reach, and how far they look for a target."

msgid "STAT_RECOIL"
msgstr "Recoil"

msgid "STAT_RECOIL_DESC"
msgstr "How hard a weapon shoves you when it fires."

msgid "STAT_SHOP_SLOTS"
msgstr "Shop Slots"

msgid "STAT_SHOP_SLOTS_DESC"
msgstr "How many things the shop offers you each visit."

msgid "STAT_SLOW_CHANCE"
msgstr "Slow Chance"

msgid "STAT_SLOW_CHANCE_DESC"
msgstr "Chance for one of your hits to slow the target."

msgid "STAT_SLOW_DURATION"
msgstr "Slow Duration"

msgid "STAT_SLOW_DURATION_DESC"
msgstr "How long a slow lasts."

msgid "STAT_SLOW_POWER"
msgstr "Slow Power"

msgid "STAT_SLOW_POWER_DESC"
msgstr "How much speed a slow takes away."

msgid "STAT_SPREAD_ANGLE"
msgstr "Spread Angle"

msgid "STAT_SPREAD_ANGLE_DESC"
msgstr "How wide a weapon scatters its shots. Lower is better."

msgid "STAT_STATUS_CHANCE"
msgstr "Status Chance"

msgid "STAT_STATUS_CHANCE_DESC"
msgstr "Chance to apply any status at all, on top of the chance for that particular one."

msgid "STAT_WEAPON_SLOTS"
msgstr "Weapon Slots"

msgid "STAT_WEAPON_SLOTS_DESC"
msgstr "How many weapons you can carry at once."

